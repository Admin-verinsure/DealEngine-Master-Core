@model DealEngine.WebUI.Models.InformationViewModel

<form id="GLViewModelForm" class="is-valid" data-accordianId="Club General Liability" method="post">
    <div class="form-group">
        <div class="row">
            <div class="col-4">
                <label for="HasYouthProgrammeOptions" class="label required">Is your club involved in a youth programme?</label>
            </div>
            <div class="col-8">
                <select id="HasYouthProgrammeOptions" name="GLViewModel.SelectedYouthProgrammes" class="form-select b" multiple required>
                    @foreach (var option in Model.GLViewModel.HasYouthProgrammeOptions)
                    {
                        <option value="@option.Value" selected="@(Model.GLViewModel.SelectedYouthProgrammes.Contains(option.Value) ? "selected" : "")">
                            @option.Text
                        </option>
                    }
                </select>
            </div>
        </div>
    </div>
</form>