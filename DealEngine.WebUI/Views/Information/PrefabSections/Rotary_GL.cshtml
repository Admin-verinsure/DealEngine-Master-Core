@model DealEngine.WebUI.Models.InformationViewModel

<form id="GLViewModel" class="is-valid" data-accordianId="Club General Liability" method="post">
@*    <div class="form-group">
*@
          <div class="form-group">
                <div class="row">
                    <div class="col-9">
                        <label for="hasinvestigation" class="label required">
                            If your Club is involved in a Youth programme?
                        </label>
                    </div>
                    <div class="col-3">
                <select id="hasinvestigation" name="GLViewModel.HasYouthProgramme" class="form-select " onchange="OnChange(this.id, this.name)" required>
                    @foreach (var option in Model.GLViewModel.HasYouthProgramme)
                            {
                                <option selected="@option.Selected" value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                </div>
          </div>

    <div id="GLViewModel.HasYouthProgramme" hidden>
                <div class="form-group">
                    <div class="row">
                        <div class="col-9">
                    <label for="youthprogrammesdetails" class="label required">
                                <strong>You have answered "Yes" </strong>, please provide full details:
                            </label>
                        </div>
                        <div class="col-3">
                            @Html.TextAreaFor(m => m.GLViewModel.YouthProgrammesDetails, new { @class = "form-control", @id = "YouthProgrammesDetails", @type = "text", onchange = "OnChange(this.id, this.name)", @required = "", @maxlength = "250", @placeholder = "Max characters is 250. Over 250 will not be stored." })
                        </div>
                    </div>
                </div>
    </div>


</form>
