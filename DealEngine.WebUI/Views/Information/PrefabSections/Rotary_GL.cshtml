@model DealEngine.WebUI.Models.InformationViewModel

<form id="GLViewModel" class="is-valid" data-accordianId="Club General Liability">


    <br />
    <br />
    <div class="form-group">
        <div class="row">
            <div class="col-9">
                <label class="label required">
                    Is you club involved in a youth programme?
                </label>
            </div>
            <div class="col-3">
                <select id="HasYouthProgramme" name="GLViewModel.HasYouthProgramme" class="form-select" onchange="OnChange(this.id, this.name)" required>
                    @foreach (var option in Model.GLViewModel.HasYouthProgramme)
                    {
                        <option selected="@option.Selected" value="@option.Value">@option.Text</option>
                    }
                </select>
            </div>
        </div>
    </div>

